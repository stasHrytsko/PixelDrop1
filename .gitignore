# The native Android project is NOT committed in the template.
#
# `npx cap add android` bakes the appId into a Java package directory path
# (android/app/src/main/java/com/example/gametemplate/), so a project generated
# here would carry the template's package forever. Each game runs
# `npm run android:add` right after `npm run new-game`, and commits android/
# from that point on — at which point delete the `android/` line below and keep
# the build-output ignores that follow.
android/

# Android build output (keep these once android/ is committed per game).
android/app/build/
android/build/
android/.gradle/
android/local.properties
android/app/src/main/assets/public/
android/app/src/main/res/xml/config.xml
android/capacitor-cordova-android-plugins/
*.apk
*.aab
*.keystore
*.jks

# Synced from node_modules/phaser/skills by scripts/sync-phaser-skills.ts on
# postinstall. Belongs to the installed Phaser version, not to this repository.
#
# Scoped to phaser-* rather than the whole directory: a skill written for *this*
# game belongs in .claude/skills/ next to them, and ignoring the directory
# wholesale made such a skill silently uncommittable.
.claude/skills/phaser-*/
.claude/skills/README.md

# Throwaway files tests/tooling/lintRules.test.ts writes into the directories the
# boundary rules govern, then deletes. Ignored so an interrupted run cannot leave
# one behind in a commit — a lingering one still fails lint, which is the point.
**/__boundary_fixture.ts

.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
